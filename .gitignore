# 编译产物
/apid
/apid-ctl
*.exe
*.out

# Go
/vendor/

# Python（scripts 下新增的脚本/工具）
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# scripts 本地一次性脚本/审查产物，不入库
/scripts/test_codex_sessions.py
/scripts/codex_sessions_review.md

# TRACE 落盘日志
/logs/

# SQLite 数据库（APID_DB，默认落到 ./data；WAL 模式还会生成 -wal/-shm sidecar）
/data/
*.db
*.db-wal
*.db-shm

# 本地转发配置（含上游地址 / Key），用 config.example.toml 作为模板
/config.toml

# 本地环境变量
.env
.env.local

# Claude Code 本地状态
/.claude/

# 编辑器
.idea/
.vscode/
.DS_Store

# webui 前端工程（node_modules；构建产物进 server/webui/dist，必须先 build 前端再 go build）
# 例外：保留 placeholder.txt 占位，保证未构建时 //go:embed 也能编译（运行时 /stats/ 会 503 提示）
node_modules/
*.tsbuildinfo
server/webui/dist/*
!server/webui/dist/placeholder.txt

# apid ops params (read by the systemd unit via EnvironmentFile).
# Copy to /etc/apid/apid.env and edit. Forwarding config lives in config.toml.

# Listen address (default :19092).
APID_LISTEN=:19092

# Graceful HTTP shutdown timeout (default 120s).
APID_SHUTDOWN_TIMEOUT=120s

# Collect token/perf metrics into SQLite. Lives under StateDirectory (/var/lib/apid).
APID_DB=/var/lib/apid/apid.db

# Trace dumping stays off by default (zero overhead). To enable, point this at a
# writable dir, e.g. APID_TRACE_DIR=/var/lib/apid/traces
# APID_TRACE_DIR=/var/lib/apid/traces

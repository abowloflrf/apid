# apid 运行配置示例。复制为 .env 后按需修改。
# 真实的进程环境变量优先级高于 .env，不会被本文件覆盖。

# 本地监听地址
APID_LISTEN=:8080

# 远程 Chat Completions 服务基础地址（会拼接 /chat/completions）
APID_UPSTREAM_BASE_URL=https://api.openai.com/v1

# 访问上游用的 API Key；留空则透传客户端请求里的 Authorization 头
APID_UPSTREAM_API_KEY=

# 转发给上游时实际使用的模型名；非空则覆盖客户端请求里的 model，留空则原样透传
APID_UPSTREAM_MODEL=

# TRACE 落盘日志：APID_TRACE 为真时落到 ./logs；或用 APID_TRACE_DIR 指定目录
# APID_TRACE=1
# APID_TRACE_DIR=./logs

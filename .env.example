# apid 运行配置示例。复制为 .env 后按需修改。
# 真实的进程环境变量优先级高于 .env，不会被本文件覆盖。

# 本地监听地址
APID_LISTEN=:19092

# 转发配置文件路径（TOML）改用命令行 flag：apid --config <path>，默认 config.toml。
# 上游（[[upstream]]）与入口路由（[[route]]）都在那个文件里配置，见 config.example.toml。

# TRACE 落盘日志：APID_TRACE 为真时落到 ./logs；或用 APID_TRACE_DIR 指定目录
# APID_TRACE=1
# APID_TRACE_DIR=./logs

# 项目通用 SQLite 数据库文件路径。空表示不启用，零开销。
# 开启后 stats 会把每条请求的指标（协议 / 模型 / URL / token / 缓存命中 / 状态等）
# 写到这个文件，可用 sqlite3 CLI 直接查询。
# APID_DB=./data/apid.db
